
. /lib/functions/leds.sh
. /lib/functions/uci-defaults.sh

board=$(board_name)
boardname="${board##*,}"

board_config_update

case $board in
cznic,turris1x)
	ucidef_set_led_wlan "wlan" "WLAN" "rgb:wlan" "phy0tpt"
	;;
enterasys,ws-ap3715i)
	ucidef_set_led_netdev "lan1" "LAN1" "green:lan1" "eth0"
	ucidef_set_led_netdev "lan2" "LAN2" "green:lan2" "eth1"
	;;
extreme-networks,ws-ap3825i)
	ucidef_set_led_netdev "lan1" "LAN1" "green:lan1" "eth1"
	ucidef_set_led_netdev "lan2" "LAN2" "green:lan2" "eth0"
	;;
hpe,msm460)
	ucidef_set_led_netdev "lan" "LAN" "green:lan" "eth0"
	;;
watchguard,xtm330)
	ucidef_set_led_netdev "port0" "port0" "Marvell 88E6171:00:02:green:lan" "port0" "link_100"
	ucidef_set_led_netdev "port1" "port1" "Marvell 88E6171:01:02:green:lan" "port1" "link_100"
	ucidef_set_led_netdev "port2" "port2" "Marvell 88E6171:02:02:green:lan" "port2" "link_100"
	ucidef_set_led_netdev "port3" "port3" "Marvell 88E6171:03:02:green:lan" "port3" "link_100"
	ucidef_set_led_netdev "port4" "port4" "Marvell 88E6171:01:02:green:lan-2" "port4" "link_100"
	ucidef_set_led_netdev "port5" "port5" "Marvell 88E6171:02:02:green:lan-2" "port5" "link_100"
	ucidef_set_led_netdev "port6" "port6" "Marvell 88E6171:03:02:green:lan-2" "port6" "link_100"
	;;
esac

board_config_flush

exit 0
