 drivers/net/dsa/mv88e6xxx/chip.h |  17 ++-
 drivers/net/dsa/mv88e6xxx/leds.c | 178 ++++++++++++++++++++++++-------
 drivers/net/dsa/mv88e6xxx/port.h |   9 ++
 4 files changed, 172 insertions(+), 42 deletions(-)

